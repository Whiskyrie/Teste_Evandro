                },
                {
                    "name": "4. Detalhes da Operadora",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/operadoras/92693118000160",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "operadoras",
                                "92693118000160"
                            ]
                        },
                        "description": "**Teste:** Busca detalhes de uma operadora específica (Bradesco Saúde S.A.).\n\n**CNPJ:** 92693118000160\n\n**Validações esperadas:**\n- Status: 200 OK\n- Campos básicos: cnpj, razao_social, registro_ans, modalidade, uf, status_validacao\n- Estatísticas: total_despesas (Decimal), qtd_trimestres (integer)\n- total_despesas > 0 (operadora tem despesas registradas)\n- qtd_trimestres >= 0"
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code é 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response contém todos os campos\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('cnpj');",
                                    "    pm.expect(jsonData).to.have.property('razao_social');",
                                    "    pm.expect(jsonData).to.have.property('total_despesas');",
                                    "    pm.expect(jsonData).to.have.property('qtd_trimestres');",
                                    "});",
                                    "",
                                    "pm.test(\"CNPJ corresponde ao solicitado\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.cnpj).to.equal('92693118000160');",
                                    "});",
                                    "",
                                    "pm.test(\"Possui despesas registradas\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(parseFloat(jsonData.total_despesas)).to.be.above(0);",
                                    "    pm.expect(jsonData.qtd_trimestres).to.be.at.least(0);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
